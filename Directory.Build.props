<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- XML documentation is written as the code is, and the repository builds at zero doc
         warnings — promoted to errors to keep it that way: CS1591 missing doc, CS1573 partial
         params, CS1574 broken cref. Test projects are unaffected (they set
         GenerateDocumentationFile=false). -->
    <WarningsAsErrors>$(WarningsAsErrors);CS1591;CS1573;CS1574</WarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Versioning -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix Condition="'$(Configuration)' == 'Debug'">dev</VersionSuffix>
  </PropertyGroup>

</Project>
