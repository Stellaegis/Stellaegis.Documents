    <ProjectReference Include="..\..\src\Stellaegis.MultiTenant\Stellaegis.MultiTenant.csproj" />
    <ProjectReference Include="..\..\src\Stellaegis.Common\Stellaegis.Common.csproj" />
  </ItemGroup>

</Project>
