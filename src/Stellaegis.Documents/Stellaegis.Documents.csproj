<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Stellaegis.Documents</RootNamespace>
    <PackageId>Stellaegis.Documents</PackageId>
    <Description>Document management: versioned documents indexed by identity, isolated per compartment or shared, with their content stored through Stellaegis.Blobs.</Description>
    <PackageTags>stellaegis;documents;document-management;versioning</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Stellaegis.Primitives" />
    <PackageReference Include="Stellaegis.Blobs" />
  </ItemGroup>

</Project>
