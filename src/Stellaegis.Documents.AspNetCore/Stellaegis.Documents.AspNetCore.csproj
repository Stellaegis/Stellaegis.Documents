<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Stellaegis.Documents.AspNetCore</RootNamespace>
    <PackageId>Stellaegis.Documents.AspNetCore</PackageId>
    <Description>ASP.NET Core endpoints for Stellaegis.Documents: upload, download, versions and trash, mapped on a group the host provides, in the space the host resolves.</Description>
    <PackageTags>stellaegis;documents;document-management;aspnetcore</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stellaegis.Documents\Stellaegis.Documents.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Stellaegis.Primitives.AspNetCore" />
  </ItemGroup>

</Project>
