<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Stellaegis.Documents.Client</RootNamespace>
    <PackageId>Stellaegis.Documents.Client</PackageId>
    <Description>HTTP client for the Stellaegis.Documents API: implements IDocumentService over the network, so a consumer works the same in process or remotely.</Description>
    <PackageTags>stellaegis;documents;document-management;client;http</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stellaegis.Documents\Stellaegis.Documents.csproj" />
  </ItemGroup>

</Project>
